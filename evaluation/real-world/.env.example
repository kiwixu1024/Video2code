# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — never commit real API keys.

# --- API credentials (required) ---
VIDEO2CODE_API_KEY=your-api-key-here
VIDEO2CODE_API_BASE=https://your-openai-compatible-endpoint/v1

# --- Models (optional overrides) ---
# Stage 1: video -> HTML generation model
VIDEO2CODE_GENERATION_MODEL=gemini-2.5-pro
# Stage 2: GUI-agent recognition/verification model
VIDEO2CODE_AGENT_MODEL=gpt-5-2025-08-07

# --- Stage 1 tunables (optional) ---
VIDEO2CODE_GEN_WORKERS=20
VIDEO2CODE_GEN_MAX_TOKENS=128000
VIDEO2CODE_GEN_STREAM=0

# --- Stage 2 tunables (optional) ---
# Directory of generated HTML to evaluate. Defaults to Stage 1's output.
# VIDEO2CODE_HTMLS_DIR=./results/htmls/gemini-2.5-pro
VIDEO2CODE_PORT_BASE=8765
VIDEO2CODE_PORT_POOL_SIZE=120
VIDEO2CODE_AGENT_WORKERS=20
