# Copy to .env and replace placeholders. Never commit .env.
VIDEO2CODE_API_KEY=your-api-key-here
VIDEO2CODE_API_BASE=https://your-openai-compatible-endpoint/v1

VIDEO2CODE_GENERATION_MODEL=qwen3-vl-235b-a22b-thinking
VIDEO2CODE_AGENT_MODEL=gpt-5-2025-08-07

# Optional input/path overrides
# VIDEO2CODE_SYNTH_URLS_FILE=./data/urls.jsonl
# VIDEO2CODE_SYNTH_FRAMES_DIR=./data/frames
# VIDEO2CODE_HTMLS_DIR=./results/htmls/qwen3-vl-235b-a22b-thinking
# VIDEO2CODE_EVAL_OUTPUT_DIR=./results/eval/qwen3-vl-235b-a22b-thinking

VIDEO2CODE_GEN_WORKERS=10
VIDEO2CODE_GEN_MAX_TOKENS=32768
VIDEO2CODE_GEN_STREAM=1
VIDEO2CODE_PORT_BASE=8765
VIDEO2CODE_PORT_POOL_SIZE=120
VIDEO2CODE_AGENT_WORKERS=20

# Comma-separated Stage 2 directories for Stage 3 aggregation.
# VIDEO2CODE_PARSE_OUTPUT_DIRS=./results/eval/model-a,./results/eval/model-b
# VIDEO2CODE_GLOBAL_SUMMARY_OUT=./results/global_summary.json
